# Copy to .env and adjust.

# Postgres (Neon). Use a separate *dev* branch locally and the main branch on the host.
#   DATABASE_URL = pooled connection string (host has "-pooler") + "&pgbouncer=true"
#   DIRECT_URL   = direct connection string (used only by migrations)
DATABASE_URL=""
DIRECT_URL=""

# Local only: allows `npm run db:seed` to wipe and refill the dev database.
# NEVER set this on the host.
ALLOW_DB_SEED="yes"

# Public base URL, used in share links, advocacy letters, emailed links and
# as the base for Google/Apple sign-in callbacks.
APP_URL="http://localhost:3000"

# Secret used to sign sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Protects the daily clean-up job (/api/cron/daily): it permanently deletes
# content moderators removed over a week ago and anonymizes accounts deleted
# over 30 days ago. Vercel sends it automatically when set. Generate one with
# the same command as above. Required in production.
# CRON_SECRET=""

# Email (verification + password reset). Leave unset in dev: emails are
# printed to the server console instead. Required in production.
# RESEND_API_KEY="re_..."
# MAIL_FROM="Groundswell <no-reply@groundswell.hahnsolo.ca>"

# Bot protection for sign-up, sign-in and password reset (Cloudflare Turnstile, free).
# Off when unset. For local testing, Cloudflare's published test keys always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Sign in with Google (optional — the button appears when both are set).
# Redirect URI to register: <APP_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Sign in with Apple (optional — the button appears when all four are set).
# Return URL to register: <APP_URL>/api/auth/callback/apple (must be HTTPS).
# APPLE_CLIENT_ID=""        # your Services ID, e.g. org.groundswell.web
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""      # contents of the .p8 file, newlines as \n
# APPLE_APP_BUNDLE_ID=""    # only if you later ship an iOS app
