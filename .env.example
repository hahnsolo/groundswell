# Copy to .env and adjust.
DATABASE_URL="file:./dev.db"

# Public base URL, used in share links, advocacy letters and emailed links.
APP_URL="http://localhost:3000"

# Email (verification + password reset). Leave unset in dev: emails are
# printed to the server console instead. Required in production.
# RESEND_API_KEY="re_..."
# MAIL_FROM="Groundswell <no-reply@yourdomain.org>"
