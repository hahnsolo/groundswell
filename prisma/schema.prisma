// Groundswell data model. Postgres everywhere (Neon in dev and production).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection, used by the running app (many short-lived serverless connections).
  url       = env("DATABASE_URL")
  // Direct connection, used by `prisma migrate` (migrations can't run through a pooler).
  directUrl = env("DIRECT_URL")
}

// ---------- Auth (managed by Better Auth — see src/lib/better-auth.ts) ----------
// User/Session/Account/Verification/RateLimit follow Better Auth's schema.
// Passwords live on Account (providerId "credential"), not on User.

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // App fields (Better Auth "additionalFields"; none are settable by sign-up).
  isAdmin          Boolean   @default(false)
  // Home area, so the app can drop people straight into their community.
  homeCountry      String?
  homePostal       String?
  // "Delete my account": set when they leave. Signing back in within the grace
  // period clears it; after that the daily job anonymizes the account (personal
  // details wiped, posts kept as "Former member") and sets anonymizedAt.
  deactivatedAt    DateTime?
  anonymizedAt     DateTime?
  // "Show my name on causes I join" (#79). Off: "A neighbour" to everyone but the people leading the cause.
  showName         Boolean   @default(true)
  // Which notification emails they want (#18; src/lib/notify-rules.ts). Lead and
  // co-lead requests always go out.
  notifyEvents     Boolean   @default(true) // the day before an event they're going to
  notifyWinCheck   Boolean   @default(true) // "is it fixed?" in a cause they joined
  notifyWins       Boolean   @default(true) // a cause they joined is won
  notifyNewMembers Boolean   @default(true) // daily: who joined the causes they lead
  notifyChatDigest Boolean   @default(false) // daily: new chat messages in their causes

  sessions           Session[]
  notifications      NotificationLog[]
  accounts           Account[]
  causes             Cause[]           @relation("CausesStarted")
  leading            Cause[]           @relation("CausesLed")
  leadOffersMade     LeadOffer[]       @relation("LeadOffersMade")
  leadOffersReceived LeadOffer[]       @relation("LeadOffersReceived")
  coLeading          CoLeader[]        @relation("CoLeading")
  coLeadInvites      CoLeader[]        @relation("CoLeadInvites")
  winProposals       WinProposal[]
  winConfirmations   WinConfirmation[]
  causeActions       CauseAction[]
  memberships        CauseMember[]
  comments           Comment[]
  meetups            Meetup[]
  rsvps              Rsvp[]
  campaigns          Campaign[]
  signatures         Signature[]
  reports            Report[]
  uploads            MediaAsset[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per way of signing in: "credential" (email + password), "google", "apple".
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Email verification and password reset tokens.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Better Auth's rate limiter state. Stored in the DB so limits hold across
// serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// App-level rate limits (posting, forms, lookups). key is a sha256 of e.g.
// "comment:<userId>" or "signin:<ip>", so no raw IPs are stored.
model Throttle {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// ---------- Community ----------

// Cached result of a postal code lookup. id = "<COUNTRY>-<normalized code>".
model Place {
  id         String   @id
  country    String
  postalCode String
  placeName  String
  region     String
  regionCode String
  lat        Float
  lng        Float
  createdAt  DateTime @default(now())
}

model Cause {
  id            String    @id @default(cuid())
  title         String
  description   String
  category      String
  // raised | gathering | organizing | taking_action | won | closed (src/lib/stages.ts).
  // Moves forward on its own from what happens; won and closed are set on purpose.
  stage         String    @default("raised")
  // When it was won (members confirmed it): shown off on the neighbourhood pages.
  resolvedAt    DateTime?
  // Closed by its leader, or after going quiet ("Went quiet").
  closedAt      DateTime?
  closedReason  String?
  // When we asked the leader "Is this still going?" after 90 quiet days.
  quietAskedAt  DateTime?
  // Who the person who raised it thinks should fix it (src/lib/fixers.ts):
  // city | province | federal | landlord | business | nonprofit | other | unsure
  fixer         String    @default("unsure")
  // What they wrote when fixer is "other".
  fixerOther    String?
  // Someone to contact the leader added by hand (a councillor Open North doesn't cover, a landlord…).
  contactName   String?
  contactRole   String?
  contactEmail  String?
  country       String
  postalCode    String
  placeName     String
  region        String
  lat           Float
  lng           Float
  // Who started it (keeps the credit) and who leads it now (edits it, moves it
  // forward). The same person until the lead is handed over (src/lib/leadership.ts).
  authorId      String
  leaderId      String
  hidden        Boolean   @default(false)
  // Set when a moderator removes it (hidden is set too). Only the author can
  // still see it, and it's deleted for good after a week (src/lib/moderation.ts).
  removedAt     DateTime?
  removedById   String?
  removalReason String?
  // Set when its leader changes the title or description (shown as "edited").
  editedAt      DateTime?
  // Cover image (#66): a wide one for the page and previews, a small one for cards.
  coverUrl      String?
  coverThumbUrl String?
  coverAlt      String?
  // Short link for flyers and posts (#67): /go/<shortCode>. Made the first time it's needed.
  shortCode     String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  media        MediaAsset[]
  author       User          @relation("CausesStarted", fields: [authorId], references: [id], onDelete: Cascade)
  leader       User          @relation("CausesLed", fields: [leaderId], references: [id], onDelete: Cascade)
  members      CauseMember[]
  comments     Comment[]
  meetups      Meetup[]
  campaigns    Campaign[]
  leadOffers   LeadOffer[]
  winProposals WinProposal[]
  actions      CauseAction[]
  coLeaders    CoLeader[]

  @@index([country, lat, lng])
  @@index([authorId])
  @@index([leaderId])
  @@index([removedAt])
}

// The leader of a cause offering to hand it to a member (#41). Open until
// answered or 7 days old; at most one open offer per cause.
model LeadOffer {
  id         String    @id @default(cuid())
  causeId    String
  fromUserId String
  toUserId   String
  createdAt  DateTime  @default(now())
  answeredAt DateTime?
  accepted   Boolean?
  cause      Cause     @relation(fields: [causeId], references: [id], onDelete: Cascade)
  from       User      @relation("LeadOffersMade", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User      @relation("LeadOffersReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([causeId])
  @@index([toUserId])
}

// Members who share leading a cause with its leader (#42). An invite is open
// until accepted (acceptedAt set) or 7 days old; declining deletes the row.
// At most 2 per cause, counting open invites.
model CoLeader {
  causeId     String
  userId      String
  invitedById String
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  cause       Cause     @relation(fields: [causeId], references: [id], onDelete: Cascade)
  user        User      @relation("CoLeading", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("CoLeadInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@id([causeId, userId])
  @@index([userId])
}

model CauseMember {
  causeId   String
  userId    String
  createdAt DateTime @default(now())
  // No notification emails about this cause (#18).
  muted     Boolean  @default(false)
  // How they found it (#67): flyer, whatsapp, instagram… (src/lib/sources.ts). Null when unknown.
  source    String?
  // A leader's or co-leader's personal invite link, /i/<code> (#68). Made the first time they open it.
  inviteCode  String? @unique
  // Who invited them, when they joined through someone's invite link (#68). A user id, not a relation.
  invitedById String?
  // When someone leading it last opened its About tab, for "3 new members since you last looked" (#75).
  lastLookedAt DateTime?
  cause     Cause    @relation(fields: [causeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([causeId, userId])
  @@index([userId])
  @@index([causeId, invitedById])
}

// One row per notification email sent (#18): counts against the daily budget,
// so sending stops safely within Resend's free plan. The daily job clears old rows.
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Comment {
  id            String    @id @default(cuid())
  causeId       String
  authorId      String
  body          String
  hidden        Boolean   @default(false)
  // Same as on Cause.
  removedAt     DateTime?
  removedById   String?
  removalReason String?
  // Set when its author fixes it within the edit window (shown as "edited").
  editedAt      DateTime?
  // Who leading the cause hid it (#71). Others see "Hidden by the people leading this cause".
  hiddenByLeaderId String?
  createdAt     DateTime  @default(now())
  cause         Cause     @relation(fields: [causeId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([causeId, createdAt])
  @@index([removedAt])
}

// Someone the people leading a cause removed from it (#71): they can't rejoin
// unless a moderator lifts it (liftedAt).
model CauseBan {
  causeId   String
  userId    String
  byUserId  String
  reason    String
  createdAt DateTime  @default(now())
  liftedAt  DateTime?

  @@id([causeId, userId])
  @@index([userId])
}

// The moderators' log of what leaders did in their causes (#71).
// kind: hide | unhide | remove | undo_hide | lift_ban. Plain ids, so the record outlives what it's about.
model LeaderAction {
  id           String   @id @default(cuid())
  kind         String
  causeId      String
  byUserId     String
  targetUserId String
  commentId    String?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model Meetup {
  id             String       @id @default(cuid())
  causeId        String
  organizerId    String
  title          String
  description    String
  startsAt       DateTime
  // After startsAt, at most 3 days later (src/lib/event-times.ts).
  endsAt         DateTime
  // Free-text venue ("Library, room 2") or a video link when online.
  location       String
  isOnline       Boolean      @default(false)
  capacity       Int?
  // Set when hosting passed to someone else (the host stepped down or left).
  hostChangedAt  DateTime?
  // Set when the host changes the details (shown as "edited").
  editedAt       DateTime?
  // Set when the day-before reminders went out (#18), so they go once.
  reminderSentAt DateTime?
  // Cover image (#66), as on Cause.
  coverUrl       String?
  coverThumbUrl  String?
  coverAlt       String?
  // As on Cause (#67).
  shortCode      String?      @unique
  createdAt      DateTime     @default(now())
  cause          Cause        @relation(fields: [causeId], references: [id], onDelete: Cascade)
  organizer      User         @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  rsvps          Rsvp[]
  media          MediaAsset[]

  @@index([causeId, startsAt])
}

// Every uploaded file (#66), so we know how much storage is used (and pause
// uploads before the free limit) and can delete files from storage. A file
// whose cause or event is gone, or that was replaced, is detached (causeId and
// meetupId null) and the daily job deletes it from storage.
model MediaAsset {
  id           String   @id @default(cuid())
  url          String   @unique
  bytes        Int
  kind         String // cover | cover_thumb
  causeId      String?
  meetupId     String?
  uploadedById String?
  createdAt    DateTime @default(now())
  cause        Cause?   @relation(fields: [causeId], references: [id], onDelete: SetNull)
  meetup       Meetup?  @relation(fields: [meetupId], references: [id], onDelete: SetNull)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([causeId])
  @@index([meetupId])
}

model Rsvp {
  meetupId  String
  userId    String
  createdAt DateTime @default(now())
  // As on CauseMember (#67).
  source    String?
  meetup    Meetup   @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetupId, userId])
  @@index([userId])
}

// An advocacy push: a concrete ask aimed at a decision-maker, backed by signatures.
model Campaign {
  id         String      @id @default(cuid())
  causeId    String
  creatorId  String
  ask        String
  target     String
  goal       Int         @default(100)
  createdAt  DateTime    @default(now())
  cause      Cause       @relation(fields: [causeId], references: [id], onDelete: Cascade)
  creator    User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  signatures Signature[]

  @@index([causeId])
}

model Signature {
  campaignId String
  userId     String
  note       String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([userId])
}

// Community moderation flags. targetType: cause | comment
model Report {
  id           String    @id @default(cuid())
  targetType   String
  targetId     String
  reason       String
  reporterId   String
  resolved     Boolean   @default(false)
  // kept | removed | restored — what a moderator decided, and who/when, for the audit trail.
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  reporter     User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, reporterId])
}

// Elected representatives for an area (Canada, via Open North), saved so pages
// don't wait on the lookup and we stay within its rate limit. Checked again
// after 30 days (src/lib/area-reps.ts). Looked up by the area's centre point only.
model AreaRepresentatives {
  country    String
  postalCode String
  // Rep[] from src/lib/representatives.ts
  reps       Json
  checkedAt  DateTime @default(now())

  @@id([country, postalCode])
}

// The leader saying "it's fixed" (#24). Won once enough other members confirm
// within 7 days; otherwise it lapses. One open proposal per cause.
model WinProposal {
  id            String            @id @default(cuid())
  causeId       String
  proposedById  String
  note          String
  createdAt     DateTime          @default(now())
  resolvedAt    DateTime?
  // won | lapsed | withdrawn
  outcome       String?
  cause         Cause             @relation(fields: [causeId], references: [id], onDelete: Cascade)
  proposedBy    User              @relation(fields: [proposedById], references: [id], onDelete: Cascade)
  confirmations WinConfirmation[]

  @@index([causeId])
}

model WinConfirmation {
  proposalId String
  userId     String
  createdAt  DateTime    @default(now())
  proposal   WinProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([proposalId, userId])
}

// The cause's timeline of things done outside Groundswell (#24): contacting
// whoever should fix it, their reply, the leader saying it's still going.
model CauseAction {
  id          String   @id @default(cuid())
  causeId     String
  createdById String
  // contacted | replied | still_going | delivered (a petition was handed over, #74)
  kind        String
  // Who was contacted, and how: letter | email | call | meeting | in_person
  who         String?
  how         String?
  note        String?
  // For "delivered": which campaign, and how many signatures went with it.
  campaignId  String?
  signatures  Int?
  happenedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  cause       Cause    @relation(fields: [causeId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([causeId, happenedAt])
}
