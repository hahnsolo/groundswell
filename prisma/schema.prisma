// Groundswell data model.
// Local dev uses SQLite. For production, switch `provider` to "postgresql"
// (see README "Going to production") — the models are portable as written.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash    String
  emailVerifiedAt DateTime?
  isAdmin         Boolean   @default(false)
  // Home area, so the app can drop people straight into their community.
  homeCountry  String?
  homePostal   String?
  createdAt    DateTime @default(now())

  sessions   Session[]
  tokens     AuthToken[]
  issues     Issue[]
  supports   IssueSupport[]
  comments   Comment[]
  meetups    Meetup[]
  rsvps      Rsvp[]
  campaigns  Campaign[]
  signatures Signature[]
  reports    Report[]
}

model Session {
  // sha256 of the cookie token — the raw token is never stored.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time emailed tokens. purpose: verify_email | reset_password
model AuthToken {
  // sha256 of the emailed token.
  id        String    @id
  userId    String
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Cached result of a postal code lookup. id = "<COUNTRY>-<normalized code>".
model Place {
  id         String   @id
  country    String
  postalCode String
  placeName  String
  region     String
  regionCode String
  lat        Float
  lng        Float
  createdAt  DateTime @default(now())
}

model Issue {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  // open | in_progress | resolved
  status      String   @default("open")
  country     String
  postalCode  String
  placeName   String
  region      String
  lat         Float
  lng         Float
  authorId    String
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  supports  IssueSupport[]
  comments  Comment[]
  meetups   Meetup[]
  campaigns Campaign[]

  @@index([country, lat, lng])
  @@index([authorId])
}

model IssueSupport {
  issueId   String
  userId    String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
}

model Meetup {
  id          String   @id @default(cuid())
  issueId     String
  organizerId String
  title       String
  description String
  startsAt    DateTime
  // Free-text venue ("Library, room 2") or a video link when online.
  location    String
  isOnline    Boolean  @default(false)
  capacity    Int?
  createdAt   DateTime @default(now())
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  organizer   User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  rsvps       Rsvp[]

  @@index([issueId, startsAt])
}

model Rsvp {
  meetupId  String
  userId    String
  createdAt DateTime @default(now())
  meetup    Meetup   @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetupId, userId])
  @@index([userId])
}

// An advocacy push: a concrete ask aimed at a decision-maker, backed by signatures.
model Campaign {
  id         String      @id @default(cuid())
  issueId    String
  creatorId  String
  ask        String
  target     String
  goal       Int         @default(100)
  createdAt  DateTime    @default(now())
  issue      Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  creator    User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  signatures Signature[]

  @@index([issueId])
}

model Signature {
  campaignId String
  userId     String
  note       String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([userId])
}

// Community moderation flags. targetType: issue | comment
model Report {
  id           String    @id @default(cuid())
  targetType   String
  targetId     String
  reason       String
  reporterId   String
  resolved     Boolean   @default(false)
  // kept | removed — what a moderator decided, and who/when, for the audit trail.
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, reporterId])
}
